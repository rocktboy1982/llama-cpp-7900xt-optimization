+        k_set_rows_turbo4<idx_t><<<grid_size, block_size, 0, stream>>>(
+            src0_d, src1_d, dst_d, ne_total_chunks, ne10, ne11, ne12, ne13,
+            s01, s02, s03, s10, s11, s12, s1, s2, s3,
+            ne00, ne00_fd, ne01_fd, ne02_fd, ne11_fd, ne12_fd);
+    }
+}
